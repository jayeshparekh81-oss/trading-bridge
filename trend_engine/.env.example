# Copy to trend_engine/.env (gitignored) and fill in real values.
# These are read from the environment ONLY — never hardcoded in the script.
#
# The fetcher only READS historical market data (POST /v2/charts/intraday).
# No order paths, no money movement. Still: treat the token as a live secret.

DHAN_ACCESS_TOKEN=
